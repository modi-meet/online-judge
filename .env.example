# copy to .env for local development. every service validates its own env at boot.
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/oj
REDIS_URL=redis://localhost:6379

# object store (minio in dev, s3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=oj
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

JWT_SECRET=change-me-in-anything-but-local

# judge worker
JUDGE_SLOTS=2
JUDGE_CPUSET_BASE=0
SANDBOX_IMAGE_TAG=dev

# v0 only. never set outside local dev — see lld 6.6
ALLOW_HOST_EXECUTOR=true

# ai mentor (v3)
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_DAILY_TOKEN_CAP=150000
