# copy to .env for local development. every service validates its own env at boot.
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/oj?directConnection=true
REDIS_URL=redis://localhost:6379

# object store. leave the s3 vars empty to use a local directory (FILE_STORE_ROOT, default ~/.oj/store).
# values under 4 kb stay inline in mongo either way.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
FILE_STORE_ROOT=

JWT_SECRET=change-me-in-anything-but-local

# judge worker
JUDGE_SLOTS=2
JUDGE_CPUSET_BASE=0
SANDBOX_IMAGE_TAG=dev
# where per-run scratch dirs live. must be under $HOME on macos (shared with the docker vm)
JUDGE_SCRATCH_ROOT=


# ai mentor (v3). runs on :4002, its own process; the gateway routes /api/ai to it.
# no AI_API_KEY means the fake provider: canned replies, the full pipeline, no bill.
AI_ENABLED=true
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL_STRONG=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
# output tokens per utc day across everyone; each user gets a tenth
AI_DAILY_TOKEN_CAP=150000
# read-only mongo user for the mentor. empty = MONGO_URI (dev only)
MONGO_URI_RO=
